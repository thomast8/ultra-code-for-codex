{
  "name": "ultra-code-for-codex",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.10.0 || 26.12.0"
  },
  "scripts": {
    "lint": "eslint src test scripts",
    "format:check": "prettier --check src test scripts plugin workflows package.json tsconfig.json eslint.config.js vitest.config.ts AGENTS.md README.md .agents acceptance.md docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "quality": "npm run lint && npm run typecheck",
    "check": "npm run format:check && npm run quality && npm run test:coverage && npm run build",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "8.20.0",
    "quickjs-emscripten": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT"
}
